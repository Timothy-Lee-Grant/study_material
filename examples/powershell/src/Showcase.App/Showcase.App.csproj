<Project Sdk="Microsoft.NET.Sdk">
  <!-- The "real application running on your system": a Generic Host console app that
       simulates a device fleet and writes it to ~/.powershell-showcase/devices.json. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Built for net8.0, but allowed to run on a newer installed runtime (9, 10, ...). -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Showcase.Core\Showcase.Core.csproj" />
  </ItemGroup>
</Project>
